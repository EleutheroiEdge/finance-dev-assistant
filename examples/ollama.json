{
  "schema_version": 1,
  "provider": "ollama",
  "model": "YOUR_MODEL",
  "endpoint": "",
  "api_key_env": "",
  "auth_header": "Authorization",
  "profile": "finance-saas",
  "allow_network": false,
  "allow_partial_review": false,
  "allowed_hosts": [],
  "allow_paths": [
    "src/",
    "tests/",
    "docs/",
    "scripts/",
    "README.md",
    "pyproject.toml"
  ],
  "protected_paths": [
    ".github/",
    "LICENSE",
    "AGENTS.md",
    "finassist.json",
    "pyproject.toml",
    "scripts/",
    "requirements-dev.lock"
  ],
  "protected_branches": [
    "main",
    "master",
    "trunk",
    "production",
    "release",
    "release/*"
  ],
  "extra_sensitive_patterns": [],
  "max_file_bytes": 48000,
  "max_packet_bytes": 120000,
  "max_output_tokens": 4096,
  "timeout_seconds": 60,
  "max_run_usd": 1.0,
  "daily_budget_usd": 5.0,
  "input_usd_per_million": 0.0,
  "output_usd_per_million": 0.0,
  "recipes": {},
  "runner_image": "",
  "required_recipes": [],
  "blocking_severities": [
    "critical",
    "high"
  ],
  "readiness_max_age_seconds": 86400,
  "allow_local_readiness": false
}
