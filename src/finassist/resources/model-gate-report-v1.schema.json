{
  "$defs": {
    "hashOrNull": {
      "pattern": "^[0-9a-f]{64}$",
      "type": [
        "string",
        "null"
      ]
    },
    "money": {
      "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?|[0-9]+(?:\\.[0-9]+)?[Ee][+-]?[0-9]+)$",
      "type": [
        "string",
        "null"
      ]
    },
    "revision": {
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
      "type": [
        "string",
        "null"
      ]
    },
    "tokens": {
      "maximum": 2000000,
      "minimum": 1,
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "$id": "urn:finledgerpoli:schema:gate-report:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "base": {
      "$ref": "#/$defs/revision"
    },
    "deployment_authority": {
      "const": false
    },
    "findings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "claim": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "evidence_status": {
            "const": "source-reference-validated-not-reproduced"
          },
          "file": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "line": {
            "minimum": 1,
            "type": "integer"
          },
          "severity": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          }
        },
        "required": [
          "severity",
          "file",
          "line",
          "claim",
          "evidence_status"
        ],
        "type": "object"
      },
      "maxItems": 50,
      "type": "array"
    },
    "head": {
      "$ref": "#/$defs/revision"
    },
    "merge_authority": {
      "const": false
    },
    "mode": {
      "const": "model-review"
    },
    "policy_sha256": {
      "$ref": "#/$defs/hashOrNull"
    },
    "reasons": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]{0,80}$",
        "type": "string"
      },
      "maxItems": 128,
      "type": "array",
      "uniqueItems": true
    },
    "report_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "request_sha256": {
      "$ref": "#/$defs/hashOrNull"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "spend": {
      "additionalProperties": false,
      "properties": {
        "actual_usd": {
          "$ref": "#/$defs/money"
        },
        "reserved_usd": {
          "$ref": "#/$defs/money"
        },
        "scope": {
          "const": "caller-retained-ledger"
        }
      },
      "required": [
        "reserved_usd",
        "actual_usd",
        "scope"
      ],
      "type": "object"
    },
    "summary": {
      "const": "Advisory model-review component only. Source references are checked; claims are not reproduced."
    },
    "usage": {
      "additionalProperties": false,
      "properties": {
        "input_tokens": {
          "$ref": "#/$defs/tokens"
        },
        "output_tokens": {
          "$ref": "#/$defs/tokens"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens"
      ],
      "type": "object"
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    }
  },
  "required": [
    "schema_version",
    "mode",
    "verdict",
    "reasons",
    "base",
    "head",
    "policy_sha256",
    "request_sha256",
    "findings",
    "usage",
    "spend",
    "merge_authority",
    "deployment_authority",
    "summary",
    "report_hash"
  ],
  "title": "finledgerpoli model-review gate report v1",
  "type": "object"
}
