{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Advisory triage request, version 1",
  "description": "Data validation only; no model, plugin or execution authorization.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
      "not": {
        "pattern": "[^A-Za-z0-9_-]"
      }
    },
    "task_revision": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
      "not": {
        "pattern": "[^0-9a-f]"
      }
    },
    "source_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "maxLength": 64
    },
    "context": {
      "type": "string",
      "maxLength": 1000000
    },
    "max_selected_checks": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1024
    },
    "candidates": {
      "type": "object",
      "properties": {
        "patterns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
                "not": {
                  "pattern": "[^A-Za-z0-9_-]"
                }
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            },
            "required": [
              "id",
              "description"
            ],
            "additionalProperties": false
          },
          "maxItems": 256
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
                "not": {
                  "pattern": "[^A-Za-z0-9_-]"
                }
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            },
            "required": [
              "id",
              "description"
            ],
            "additionalProperties": false
          },
          "maxItems": 256
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
                "not": {
                  "pattern": "[^A-Za-z0-9_-]"
                }
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            },
            "required": [
              "id",
              "description"
            ],
            "additionalProperties": false
          },
          "maxItems": 256
        }
      },
      "required": [
        "patterns",
        "files",
        "checks"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "task_revision",
    "source_digest",
    "context",
    "max_selected_checks",
    "candidates"
  ],
  "additionalProperties": false
}
