include LICENSE README.md SECURITY.md CONTRIBUTING.md AGENTS.md CHANGELOG.md requirements-dev.lock requirements.txt CODE_OF_CONDUCT.md
include .gitignore .dockerignore .gitattributes
include llms.txt
graft schemas
graft docs
graft examples
graft skills
graft scripts
graft .claude/agents
graft .codex/agents
graft .github/workflows
graft dashboard
prune dashboard/node_modules
prune dashboard/test-results
prune dashboard/playwright-report
prune dashboard/.cache
global-exclude __pycache__ *.py[cod]
prune .finassist
prune .venv
