include LICENSE README.md SECURITY.md CONTRIBUTING.md AGENTS.md requirements-dev.lock
include .gitignore .dockerignore .gitattributes
graft docs
graft examples
graft skills
graft scripts
graft .claude/agents
graft .codex/agents
graft .github/workflows
graft dashboard
prune dashboard/node_modules
prune dashboard/test-results
prune dashboard/playwright-report
prune dashboard/.cache
global-exclude __pycache__ *.py[cod]
prune .finassist
prune .venv
